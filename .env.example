# Server
SERVER_PORT=8080
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM=events
REDIS_GROUP=event-processors

# PostgreSQL
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/eventdb?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5

# Worker Pool
WORKER_POOL_SIZE=4
WORKER_BATCH_SIZE=500
WORKER_FLUSH_INTERVAL=2s
